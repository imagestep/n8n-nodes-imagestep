{
  "name": "n8n-nodes-imagestep",
  "version": "0.1.9",
  "description": "ImageStep for n8n — the image step for your automations: generate, edit, remove background, upscale, resize, convert and read metadata as one node, plus a webhook trigger for finished jobs.",
  "license": "MIT",
  "author": {
    "name": "ImageStep",
    "email": "support@imagestep.dev"
  },
  "main": "index.js",
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "static-ops": "node scripts/static-ops.mjs",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ImageStepApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ImageStep/ImageStep.node.js",
      "dist/nodes/ImageStepTrigger/ImageStepTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "n8n-workflow": "^2.16.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imagestep/n8n-nodes-imagestep.git"
  },
  "homepage": "https://imagestep.dev/docs/n8n?utm_source=npm&utm_medium=node-package",
  "bugs": {
    "url": "https://imagestep.dev/support?utm_source=npm&utm_medium=node-package"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "imagestep",
    "image",
    "remove-background",
    "upscale",
    "image-generation",
    "resize",
    "convert",
    "automation"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.34.5"
}
